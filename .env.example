# Environment variables for allugare.
#
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# The local demo (DJANGO_SETTINGS_MODULE=settings_dev) needs NONE of these —
# they only matter for the original production settings package.

# Django
DJANGO_SECRET_KEY=

# Email (Gmail SMTP in the original deploy)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# AWS S3 (static/media storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Maps (server-side geocoding in lares/ListingDetail).
# The browser-side Maps JS key is injected into templates separately.
GOOGLE_MAPS_API_KEY=

# PostgreSQL (production); the local demo uses SQLite and ignores this.
# DATABASE_URL=postgres://user:pass@host:5432/db_allugare
